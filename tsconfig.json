{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/api/*": ["./src/services/api/*"],
      "@/store/*": ["./src/stores/*"],
      "@/helpers/*": ["./src/utils/*"],
      "@api/*": ["./src/services/api/*"],
      "@theme/*": ["./src/lib/theme/mui/*"],
      "@shared/*": ["./src/components/*", "./src/utils/*"],
      "@shared/components/*": [
        "./src/components/*",
        "./src/components/common/*",
        "./src/components/ui/*"
      ],
      "@shared/helpers/*": ["./src/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "hospixo-frontend", "**/*.test.ts", "**/*.test.tsx"]
}
