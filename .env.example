# Backend BFF proxy (server-only — never prefix these with NEXT_PUBLIC_)
# Browser → /api/v1|v2 → serverApi → API_BASE_URL (JWT attached server-side)
API_BASE_URL=
# Explicit BFF enable for QA/prod. Defaults to on when API_BASE_URL is set.
API_PROXY_ENABLED=true
API_SECRET=
# When true, BFF returns handler.ts mocks and does not call API_BASE_URL
API_MOCK=false

# true  = GETs load in the page via serverApi (no browser list/detail fetches)
# false = client may call same-origin /api/v1|v2 (React Query / api.get)
NEXT_PUBLIC_API_SERVER_FETCH=false

# GrowthBook feature flags (browser SDK — values from your GrowthBook project)
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=
NEXT_PUBLIC_GROWTHBOOK_API_HOST=

# LocatorJS (click-to-code in dev mode: true | false)
NEXT_PUBLIC_ENABLE_LOCATOR=true
