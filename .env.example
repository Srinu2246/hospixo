# Copy to .env.local and adjust for your environment.

# Required for login and BFF proxy (src/services/api/serverClient.ts)
API_BASE_URL=https://dev-api.hospixo.com

# Optional bearer for upstream calls when no user session is present
# API_SECRET=

# Used as fallback if API_BASE_URL is unset (prefer API_BASE_URL in production)
NEXT_PUBLIC_API_URL=https://dev-api.hospixo.com

# Local dev with mocks instead of real API:
# API_MOCK=true
