{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004 --turbopack",
    "dev:webpack": "next dev -p 3004",
    "dev:clean": "rm -rf .next && next dev -p 3004 --turbopack",
    "dev-mocked": "API_MOCK=true next dev -p 3004 --turbopack",
    "start-mocked": "API_MOCK=true next dev -p 3004 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cspell": "cspell .",
    "knip": "node --env-file=.knip.env ./node_modules/knip/bin/knip.js",
    "pre-commit": "lint-staged && knip && cspell",
    "test": "node --import ./scripts/test-loader.mjs --test src/**/*.test.ts",
    "test:growthbook": "node --import ./scripts/test-loader.mjs --test src/integrations/growthbook/growthbook.test.ts",
    "codequality": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm cspell && pnpm knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@growthbook/growthbook-react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.5.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.54.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@locator/babel-jsx": "^0.5.1",
    "@locator/runtime": "^0.5.1",
    "@locator/webpack-loader": "^0.5.1",
    "@treelocator/runtime": "0.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "8.19.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
