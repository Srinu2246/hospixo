{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": {
    "config": ["next.config.mjs"],
    "entry": [
      "src/middleware.ts",
      "src/app/**/{page,layout,loading,error,not-found,global-error,route,default}.{js,jsx,ts,tsx}",
      "src/app/**/route.{js,jsx,ts,tsx}",
      "src/app/api/**/route.{js,jsx,ts,tsx}"
    ]
  },
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@babel/preset-typescript",
    "@locator/babel-jsx",
    "@locator/webpack-loader",
    "@treelocator/runtime"
  ],
  "ignoreIssues": {
    "src/lib/mocks/reports/reports.mocks.ts": ["exports"],
    "src/lib/mocks/pos/branchOrderSettle.mocks.ts": ["exports"],
    "src/lib/mocks/dashboard/dashboard.mocks.ts": ["exports"],
    "src/lib/schemas/pos/point-of-sale/tables/createBranchOrderSchema.ts": ["exports", "types"],
    "src/lib/mocks/pos/usePosOrders.mocks.ts": ["types"],
    ".husky/**": ["unlisted", "binaries"]
  },
  "husky": false,
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "off",
    "enumMembers": "off"
  }
}
